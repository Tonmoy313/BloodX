#!/usr/bin/env bash
set -e
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACM)

# 1. forbidden files
bad=$(printf '%s\n' "$staged" | grep -Ei '(^|/)\.env($|\.)|passwords\.yaml$|\.jks$|\.keystore$|key\.properties$|service-account.*\.json$' | grep -v '\.env\.example$' || true)
if [ -n "$bad" ]; then
  echo "pre-commit: refusing to commit secret-like files:"; echo "$bad"; exit 1
fi

# 2. secret scan
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --no-banner 2>/dev/null || gitleaks protect --staged --no-banner
else
  echo "pre-commit: gitleaks not installed, skipping local secret scan (CI will still scan)."
fi

# 3. quality check when Dart code changed
if printf '%s\n' "$staged" | grep -Eq '\.dart$|pubspec\.yaml$'; then
  bash scripts/check.sh
fi
