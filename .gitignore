# ============================================
# OS / IDE noise (workspace-wide)
# ============================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~

.idea/
*.iml
*.ipr
*.iws
*.iws

# Keep committed VS Code config, ignore the rest
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# ============================================
# Environment / secrets
# ============================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# ============================================
# Root-level Dart workspace artifacts
# ============================================
.dart_tool/
.packages
.pub-cache/
.pub/
.flutter-plugins
.flutter-plugins-dependencies

# Root build output (workspace-level)
/build/
*.dill
*.dill.d
*.snapshot
*.track.dill

# NOTE: pubspec.lock intentionally NOT ignored (app repos should commit it)

# ============================================
# Graphify output (generated analysis)
# ============================================
graphify-out/
**/graphify-out/
.graphify_root
.graphify_labels.json
.graphify_labels.json.sig

# ============================================
# Sentry wizard binary (large, per-package)
# ============================================
sentry-wizard.exe

# ============================================
# Logs
# ============================================
*.log
logs/

# ============================================
# Misc
# ============================================
structure.txt
skills-lock.json